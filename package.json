{
  "name": "holotable",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "AUTH_MODE=demo OIDC_ISSUER= OIDC_CLIENT_ID= OIDC_CLIENT_SECRET= OIDC_JWKS_URL= OIDC_MCP_CLIENT_ID= next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "LOG_LEVEL=silent node --test --import tsx \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "test:fuzz": "LOG_LEVEL=silent node --test --import tsx test/sql-safety.fuzz.test.ts test/promql-safety.fuzz.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "config:check": "tsx scripts/config-check.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:verify": "tsx scripts/migrate-verify.ts",
    "seed": "tsx scripts/seed.ts",
    "self-metrics": "tsx scripts/self-metrics.ts",
    "smoke": "tsx scripts/smoke.ts",
    "load:stream": "tsx scripts/load-stream.ts",
    "fixture:capture": "tsx scripts/capture-spec-fixture.ts",
    "eval": "LOG_LEVEL=silent tsx scripts/eval.ts",
    "e2e": "tsx e2e/prepare.ts && playwright test -c e2e",
    "e2e:down": "docker compose -f e2e/compose.yml down --volumes"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.113",
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/azure": "4.0.99",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/mistral": "4.0.62",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/react": "4.0.140",
    "@ai-sdk/xai": "5.0.20",
    "@base-ui/react": "1.8.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11",
    "@next/env": "16.4.0",
    "@prometheus-io/client": "0.16.1",
    "@prometheus-io/lezer-promql": "0.315.0",
    "ai": "7.0.137",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "jose": "6.2.12",
    "libpg-query": "18.1.5",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "undici": "8.11.2",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6"
  }
}
