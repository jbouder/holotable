{
  "name": "holotable",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "AUTH_MODE=demo OIDC_ISSUER= OIDC_CLIENT_ID= OIDC_CLIENT_SECRET= OIDC_JWKS_URL= next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "LOG_LEVEL=silent node --test --import tsx \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "test:fuzz": "LOG_LEVEL=silent node --test --import tsx test/sql-safety.fuzz.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "config:check": "tsx scripts/config-check.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:verify": "tsx scripts/migrate-verify.ts",
    "seed": "tsx scripts/seed.ts",
    "self-metrics": "tsx scripts/self-metrics.ts",
    "smoke": "tsx scripts/smoke.ts",
    "fixture:capture": "tsx scripts/capture-spec-fixture.ts",
    "e2e": "tsx e2e/prepare.ts && playwright test -c e2e",
    "e2e:down": "docker compose -f e2e/compose.yml down --volumes"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/react": "4.0.130",
    "@base-ui/react": "1.8.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@next/env": "16.3.8",
    "@prometheus-io/client": "0.16.1",
    "ai": "7.0.127",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "jose": "6.2.12",
    "libpg-query": "18.1.5",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6"
  }
}
