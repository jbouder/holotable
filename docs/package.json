  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.0",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
