{
  "name": "holotable-docs",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-reference.mjs",
    "dev": "npm run generate && astro dev",
