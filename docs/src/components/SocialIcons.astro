---
/**
 * Starlight's social links in the foreground color rather than the accent,
 * opening in a new tab since every one leaves the docs.
 */
import config from "virtual:starlight/user-config";
import { Icon } from "@astrojs/starlight/components";

const links = config.social || [];
---

{
  links.map(({ label, href, icon }) => (
    <a href={href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
      <span class="sr-only">{label} (opens in a new tab)</span>
      <Icon name={icon} />
    </a>
  ))
}

<style>
  a {
    color: var(--sl-color-white);
    padding: 0.5em;
    margin: -0.5em;
  }

  a:hover {
    color: var(--sl-color-gray-2);
  }
</style>
