{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Holotable",

  // The repository's compose file first, so the dev service joins the same
  // network as the stack it is meant to develop against rather than a copy of
  // it. See .devcontainer/docker-compose.yml for why there are two files.
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app-dev",
  "workspaceFolder": "/workspaces/holotable",

  // Everything `docker compose up` starts except `app` itself: the dev server
  // is `npm run dev` in this container, and starting the production image too
  // would take port 3000 and serve a stale build. `seed` brings the demo
  // workspace and its dashboards, so a fresh Codespace has live data.
  "runServices": ["postgres", "keycloak", "migrate", "seed"],

  "features": {
    // For the Testcontainers-based integration suite (#87). The compose stack
    // above runs on the outer daemon; this is a nested one those tests own.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // 3000 is this container's dev server. The other two live in sibling compose
  // services, which is what the "service:port" form forwards.
  "forwardPorts": [3000, "postgres:5432", "keycloak:8080"],
  "portsAttributes": {
    "3000": { "label": "Holotable", "onAutoForward": "notify" },
    "postgres:5432": { "label": "TimescaleDB", "onAutoForward": "silent" },
    "keycloak:8080": { "label": "Keycloak", "onAutoForward": "silent" }
  },

  // On the host, before compose is invoked: docker-compose.yml fails to parse
  // without SESSION_SECRET (`:?`), and it reads it from .env.
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "bradlc.vscode-tailwindcss"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          // Only the safe fixes. Import sorting is off in biome.json, and a
          // save that reordered imports anyway would leave `npm run lint`
          // disagreeing with the editor.
          "source.fixAll.biome": "explicit"
        },
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
        "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" },
        "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
        "[css]": { "editor.defaultFormatter": "biomejs.biome" },
        // Tailwind v4 has no tailwind.config.*; the theme is declared in CSS,
        // and IntelliSense needs to be pointed at it explicitly.
        "tailwindCSS.experimental.configFile": "src/app/globals.css",
        "tailwindCSS.experimental.classRegex": [
          ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
        ],
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "node"
}
