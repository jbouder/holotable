# ---------------------------------------------------------------------------
# Start here. With `docker compose up -d postgres seed` running, these four
# lines are all `npm run dev:demo` needs: demo sign-in, no Keycloak, the seeded
# dashboards. The model is optional; left empty, generation, Explore and chat
# say what to set instead of failing. See docs/getting-started/quick-start.
# Everything below has a working default for that loop.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://holotable:holotable@localhost:5432/holotable
# Replace this with a random value of at least 32 characters.
SESSION_SECRET=change-me-to-a-random-secret-of-32-characters
# The model id and key for AI_PROVIDER (openai-compatible by default; see "AI
# provider" below for OPENAI_BASE_URL, the gateway and the options). An empty
# value is read as unset, here and for every OPENAI_* / AI_* variable.
AI_MODEL=
# OPENAI_API_KEY=

# PostgreSQL
# The Docker Compose services build their own internal DATABASE_URL from these.
POSTGRES_USER=holotable
POSTGRES_PASSWORD=holotable
POSTGRES_DB=holotable
# DATABASE_URL is at the top: postgresql://<user>:<password>@<host>:5432/holotable
PG_POOL_MAX=10

# TimescaleDB seeder (privileged write connection; defaults to DATABASE_URL)
TIMESCALEDB_URL=

# Source credentials.
# A source names a secret_ref, and SOURCE_SECRET_REFS declares which workspaces
# may use each one: `REF:ws1,ws2; OTHER:*` ("*" = every workspace). A ref not
# granted to a source's workspace never resolves, and unset grants nothing
# (an error in production; set it empty if no source is configured yet). The
# demo sources the seeder registers live in the `demo` workspace.
SOURCE_SECRET_REFS=TS_METRICS:demo
# Credentials for a granted ref are <SECRET_REF>_USERNAME / <SECRET_REF>_PASSWORD,
# read from files of those names in SOURCE_SECRETS_DIR when set (a mounted
# Kubernetes Secret, refreshed without a restart), else from the environment.
# SOURCE_SECRETS_DIR=/var/run/holotable/source-secrets

# DuckDB sources (#572): a directory of Parquet, CSV and JSON files, or a .duckdb
# file, read in process. DUCKDB_SOURCES_DIR is the absolute directory they may
# read; a source's path resolves inside it or is refused. Unset (the default)
# refuses every DuckDB source. Each source gets its own
# engine, bounded by DUCKDB_MEMORY_LIMIT (default 512MB) and DUCKDB_THREADS
# (default 2).
# With it set, `npm run seed` also writes the files demo under <dir>/demo/
# and registers the "Demo files" source and dashboard over it; for the host
# loop, an absolute path to this checkout's data/duckdb (gitignored) does.
# DUCKDB_SOURCES_DIR=/var/lib/holotable/files
# DUCKDB_MEMORY_LIMIT=512MB
# DUCKDB_THREADS=2
# Uploads (#595): a source admin may upload CSV and JSON files from the browser, which
# land under <DUCKDB_SOURCES_DIR>/uploads/<workspace>/, so the server needs
# write access there (the rest of the root can stay read-only). Uploads are
# off, with the reason on the Data sources page, when it cannot write it.
# The largest file in bytes (default 50 MiB) and the most files per upload
# (default 20, at most 200).
# DUCKDB_UPLOAD_MAX_BYTES=52428800
# DUCKDB_UPLOAD_MAX_FILES=20

# TimescaleDB application source (read-only connection)
TS_METRICS_HOST=localhost
TS_METRICS_PORT=5432
TS_METRICS_USERNAME=metrics_ro
TS_METRICS_PASSWORD=readonly

# Seeder
SEED_DEMO=true
SEED_INTERVAL_MS=2000
# Insert this much history before streaming, e.g. 30m, 6h or 1d (at most 7d),
# so a fresh database does not start with empty charts. Unset = no backfill.
# A restart fills only the gap since the newest row, never doubling history.
# SEED_BACKFILL=6h
# The files demo (a DuckDB source over Parquet, CSV and JSON files the seeder
# writes under DUCKDB_SOURCES_DIR, and its dashboard) is opt-in.
# SEED_DEMO_FILES=true

# Self-monitoring collector (scripts/self-metrics.ts). Scrapes the app's own
# /api/metrics into metrics.holotable_self, which the seeder registers as the
# `holotable-self` source. Needs METRICS_TOKEN below to match the app's.
METRICS_URL=http://localhost:3000/api/metrics
SELF_METRICS_INTERVAL_MS=15000
# Where the seeder registers the `prometheus-self` source and the PromQL
# self-monitoring dashboard, once it answers: the Prometheus of
# `docker compose --profile prometheus`, which scrapes the same /api/metrics.
# docker compose sets http://prometheus:9090; from the host it is the
# published port. `npm run smoke` checks that dashboard too while this is
# set; leave it empty for a stack without the prometheus profile.
PROMETHEUS_SELF_URL=http://localhost:9090
# Where the seeder registers the `loki-self` source and the Holotable logs
# dashboard, once it answers: the Loki of `docker compose --profile logs`,
# which holds the stack's own log lines. docker compose sets
# http://loki:3100. `npm run smoke` checks that dashboard too while this is
# set; leave it empty for a stack without the logs profile.
LOKI_SELF_URL=http://localhost:3100

# Session. SESSION_SECRET is at the top.
# The session cookie's name. When the cookie is Secure (see below) it is sent
# as __Host-<name>, so do not add a __Host- or __Secure- prefix here.
SESSION_COOKIE_NAME=holotable_session
# Whether session cookies are Secure. Unset = true in production. Set false only
# to serve plain http:// in production mode (the quick-start image does), since
# browsers drop Secure cookies there.
# SESSION_COOKIE_SECURE=false

# Origins besides this app's own that may send it a state-changing request
# (POST, PUT, PATCH, DELETE) with the session cookie. Exact origins, comma
# separated, e.g. https://portal.example.com. Empty allows only the app itself.
ALLOWED_ORIGINS=

# Security headers
# Set to true to send the Content-Security-Policy as report-only (violations
# are logged in the browser console, nothing is blocked) while rolling it out.
CSP_REPORT_ONLY=false

# AI provider
# Set AI_PROVIDER to "gateway" or "openai-compatible" and choose a model.
#
# openai-compatible examples:
#
#   The openai-compatible path uses the Responses API (`/responses`) by
#   default. Set OPENAI_API=chat to switch to the Chat Completions API
#   (`/chat/completions`) for providers that only expose that surface.
#
#   OpenRouter (any OpenRouter model slug — uses the default Responses API):
#     AI_PROVIDER=openai-compatible
#     OPENAI_BASE_URL=https://openrouter.ai/api/v1
#     OPENAI_API_KEY=<your-openrouter-api-key>
#     AI_MODEL=openai/gpt-4o-mini
#
#   OpenCode Zen / Go (OpenAI-compatible models only — use the base URL and key
#   provided by OpenCode; only models that expose an OpenAI-compatible
#   /chat/completions interface are supported via this path, so set
#   OPENAI_API=chat). NOTE: OpenCode uses BARE model ids (no vendor/ prefix),
#   unlike OpenRouter's slugs above. Query GET <base-url>/models for exact ids:
#     AI_PROVIDER=openai-compatible
#     OPENAI_API=chat
#     OPENAI_BASE_URL=https://opencode.ai/zen/v1
#     OPENAI_API_KEY=<your-opencode-api-key>
#     AI_MODEL=kimi-k2.7-code
# AI_MODEL and OPENAI_API_KEY are at the top.
AI_PROVIDER=openai-compatible
# OPENAI_API=
# OPENAI_BASE_URL=
# AI_GATEWAY_API_KEY=
# Several server models, from any provider (#440): a JSON file listing them,
# each with variable NAMES for its credentials, never values. The variables
# above then become one more model, named "default". See
# docs/admin/models (Server models).
# AI_MODELS_FILE=/etc/holotable/models.json
# Deadline for one model request, retries included (ms); keep it under 120000,
# the model-backed routes' maxDuration.
AI_REQUEST_TIMEOUT_MS=90000
# Retries after a 429, 5xx or dropped connection, with jittered backoff (0-10).
AI_MAX_RETRIES=2
# Hosts and ranges a model base URL entered in the app (the Models page) may
# reach although they are not public, and hosts it may reach over plain http,
# e.g. a local Ollama: ollama.internal,10.0.0.0/8.
# Empty: an in-app base URL must be public https.
AI_BASE_URL_ALLOWLIST=

# A model on this machine (#607): Ollama, LM Studio, anything answering the
# OpenAI-style GET /models. auto (the default) looks only when AUTH_MODE=local;
# on and off say so outright. While on, each endpoint's host is reachable by
# the probe and the models it finds as if it were in AI_BASE_URL_ALLOWLIST; a
# base URL typed in the app is still held to AI_BASE_URL_ALLOWLIST alone.
# LOCAL_MODEL_DETECT=auto
# The base URLs probed, comma- or whitespace-separated. The default is Ollama's
# and LM Studio's, from inside a container and from outside one:
# LOCAL_MODEL_ENDPOINTS=http://host.docker.internal:11434/v1, http://localhost:11434/v1, http://host.docker.internal:1234/v1, http://localhost:1234/v1

# Prometheus sources. Hosts and ranges a source URL may reach although they
# are not public, and hosts it may reach over plain http, e.g. an in-cluster
# Prometheus: prometheus.monitoring.svc,10.0.0.0/8. Every workspace's source
# admins may use what is listed. Empty: a source URL must be public https.
# The default reaches the compose stack's Prometheus and Loki, as
# `prometheus` and `loki` from inside the stack and as `localhost` from the
# host.
SOURCE_URL_ALLOWLIST=prometheus,loki,localhost
# The smallest step, the most points per series, and the most series per
# result a Prometheus query is held to.
PROMETHEUS_MIN_STEP_MS=15000
# How far back discovery, refresh and the connection test look for series.
PROMETHEUS_DISCOVERY_WINDOW=1h
PROMQL_MAX_POINTS=1000
PROMETHEUS_MAX_SERIES=100

# Loki sources reach their URL under the same SOURCE_URL_ALLOWLIST. The most
# log lines one query asks for (newest first, inside MAX_QUERY_ROWS), and the
# most series a LogQL metric query's result may hold.
LOKI_MAX_ENTRIES=1000
LOKI_MAX_SERIES=100

# LLM limits (every model-backed route: generate, source draft, dashboard chat)
# Model requests per minute per user in a workspace; 0 disables.
LLM_RATE_PER_MINUTE=20
# Input + output tokens per workspace per UTC day; 0 disables.
# Both can be overridden per workspace in the workspace_limits table.
LLM_DAILY_TOKEN_BUDGET=2000000
# Most model calls in flight on this server at once, across every workspace;
# past it a call is refused with 429 and Retry-After. 0 turns the cap off.
LLM_MAX_IN_FLIGHT=16

# How people sign in: oidc (Keycloak, the default), demo or local. demo gives
# every visitor a session with no login, for public demos; local signs in
# everyone who can reach the server as its one owner, for your own machine
# (the quick-start image's default). Both refuse to boot if any OIDC_ISSUER /
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET / OIDC_JWKS_URL / OIDC_MCP_CLIENT_ID is
# set. Never use either with a real credential or on a host others can reach.
# See docs/admin/demo-mode.
AUTH_MODE=oidc
# The groups every demo visitor holds (AUTH_MODE=demo only). Viewer or editor
# only; source-admin and /platform-admins refuse to boot.
# DEMO_GROUPS=/workspaces/demo/editor
# The groups the local owner holds (AUTH_MODE=local only). At least one
# workspace role, source-admin allowed; /platform-admins refuses to boot.
# LOCAL_GROUPS=/workspaces/local/source-admin

# Keycloak OIDC
OIDC_ISSUER=http://localhost:8080/realms/holotable
OIDC_CLIENT_ID=holotable
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_JWKS_URL=http://localhost:8080/realms/holotable/protocol/openid-connect/certs
OIDC_GROUPS_CLAIM=groups
# Realm claims carried into sessions for a source's row filter to read, e.g.
# "tenant" (#31). A row filter can always use "sub" without this. Empty carries
# none. See docs/operations/row-level-filters.
ROW_FILTER_CLAIMS=
OIDC_SCOPE=openid profile email groups
OIDC_AUDIENCE=
# Linked from Settings > Account so people can manage what Keycloak owns.
OIDC_ACCOUNT_URL=http://localhost:8080/realms/holotable/account
# The public realm client MCP clients (Claude Code, Claude Desktop) sign in
# through to reach /api/mcp (#149). Unset keeps /api/mcp closed. See
# docs/operations/keycloak, "MCP clients".
OIDC_MCP_CLIENT_ID=holotable-mcp

# Dashboard and query defaults
DEFAULT_REFRESH_INTERVAL_MS=15000
MIN_REFRESH_INTERVAL_MS=2000
# A panel that fails this many times in a row stops running on every refresh
# and backs off, doubling up to POLLER_MAX_BACKOFF_MS. One success resets it.
POLLER_FAILURE_THRESHOLD=3
POLLER_MAX_BACKOFF_MS=300000
DEFAULT_TIME_FROM=now-1h
DEFAULT_TIME_TO=now
MAX_QUERY_ROWS=5000
# Serialized size cap (bytes of JSON) per query result; default 4 MiB.
MAX_RESULT_BYTES=4194304
# The longest range, subquery range or offset a PromQL panel may ask for.
PROMQL_MAX_RANGE=7d
# The longest range or offset a LogQL panel may ask for; PROMQL_MAX_RANGE
# when unset.
# LOGQL_MAX_RANGE=7d
# Rows a panel holds in the browser. One point budget with PROMQL_MAX_POINTS:
# keep the two equal so a PromQL series fits its panel whole.
MAX_WINDOW_POINTS=1000
QUERY_TIMEOUT_SECONDS=20
# Most connections open at once to any one metrics source, per app instance.
# Queries beyond it wait for a free connection.
MAX_POOL_PER_SOURCE=5

# Days a source catalog may go unchecked against the live database before it is
# reported as stale. Stale only warns; a catalog that has NEVER been refreshed
# blocks generation against that source. 0 disables the age check.
CATALOG_STALE_AFTER_DAYS=30

# Dashboard chat history. A conversation is scoped to one person on one
# dashboard, capped at this many messages and expired after this many days.
# The cap is enforced on write and on read, so lowering it takes effect at
# once. 0 days disables the age check and leaves only the message cap.
CHAT_HISTORY_MAX_MESSAGES=100
CHAT_HISTORY_RETENTION_DAYS=30
# Chat conversations (#416) one person keeps. Past it, the least recently used
# one is deleted when a new one starts. The two limits above apply within each.
CHAT_CONVERSATIONS_MAX=200

# Generation log retention (days). Every model generation records one redacted
# prompt/spec pair so a wrong dashboard can be traced back to what was asked.
# The sweep runs on write and on a timer. 0 disables the age check and lets the
# log grow.
GENERATION_LOG_RETENTION_DAYS=30

# How often (ms) the retention sweep deletes generation-log rows, conversations
# and messages past their retention, so a quiet workspace is swept too. 0 turns
# the timer off; the sweeps on write still run.
RETENTION_SWEEP_INTERVAL_MS=3600000

# Versions kept per dashboard; a save past it removes the oldest, never the
# current one. 0 keeps every version.
DASHBOARD_VERSIONS_KEEP=100

# Most dashboard pollers this process runs; a stream needing one more is told
# to retry shortly. 0 derives it from the Node heap limit (about 11 MB each).
MAX_POLLERS=0

# Graceful shutdown budget (ms) after SIGTERM: readiness starts failing,
# pollers stop, SSE subscribers get a reconnect hint, in-flight queries are
# awaited, then the pools close. Keep it below the orchestrator's kill timeout
# (compose stop_grace_period, Kubernetes terminationGracePeriodSeconds).
SHUTDOWN_GRACE_MS=10000

# How often (ms) an open dashboard stream re-verifies its session and
# re-authorizes the dashboard, so one deleted or moved out of the viewer's
# workspaces stops streaming. Streams also end at the session token's expiry
# and when the session is revoked, whatever this is.
SSE_REAUTH_INTERVAL_MS=60000

# Cycles in a row a dashboard stream may fall behind (a viewer or proxy that
# stopped reading) before it is closed; the browser reconnects and resumes.
SSE_SLOW_TICKS=3

# The longest a service-account API token may live, in days. Every token has
# an expiry no later than this, so a forgotten one runs out on its own.
API_TOKEN_MAX_DAYS=90

# Build identity, reported by GET /api/health so an operator can tell which
# build is answering. Both are optional: the version falls back to the one in
# package.json and the commit reads "unknown". The Dockerfile takes GIT_COMMIT
# as a build argument (--build-arg GIT_COMMIT=$(git rev-parse HEAD)).
APP_VERSION=
GIT_COMMIT=

# Docker Compose only; the server never reads it. Which published image tag
# `docker compose up` pulls: unset follows `main`, a version such as 0.2.0 pins
# a release. `docker compose up --build` ignores it and builds this checkout.
# HOLOTABLE_TAG=main

# Logging
# LOG_LEVEL: debug, info, warn, error, or silent. Defaults to debug in
# development and info in production.
# LOG_FORMAT: json (one object per line, for an aggregator) or pretty (for a
# terminal). Defaults to pretty in development and json in production.
# Every line carries the id of the request that produced it, echoed to the
# caller as the x-request-id response header.
LOG_LEVEL=
LOG_FORMAT=

# Prometheus scrape endpoint (GET /api/metrics)
# Closed with a 404 until one of these is set. METRICS_TOKEN is a bearer token
# the scraper presents; METRICS_ALLOWED_CIDRS is a comma-separated list of
# addresses or CIDR ranges, matched against the last X-Forwarded-For hop and
# therefore only meaningful behind a proxy that sets it. Set both and both are
# required. Generate a token with `openssl rand -hex 32`.
#
# The self-monitoring demo needs one: leave this blank and the collector is
# refused with a 404 and that dashboard stays empty. `docker compose` falls
# back to a checked-in local default so `docker compose up` works with no
# setup; anything reachable from outside its own network should set a real
# token here.
METRICS_TOKEN=
METRICS_ALLOWED_CIDRS=

# The named theme a browser shows before its person picks one: a built-in theme
# (holotable, graphite, fjord, paper, high-contrast) or the name in THEME_FILE.
THEME_DEFAULT_PALETTE=holotable
# An operator's own theme: the absolute path to a JSON file of token values in
# both schemes, checked against the operator quality bar at boot. See
# docs/src/content/docs/admin/themes.md; `npm run --silent themes:export graphite -- --as <name>` writes
# a valid starting point.
THEME_FILE=
