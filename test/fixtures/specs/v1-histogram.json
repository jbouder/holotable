{
  "specVersion": 1,
  "title": "Latency distributions",
  "timeRange": {
    "from": "now-1h",
    "to": "now"
  },
  "refreshIntervalMs": 30000,
  "panels": [
    {
      "id": "sql-latency",
      "title": "Latency distribution",
      "viz": "histogram",
      "format": "ms",
      "query": {
        "sourceId": "ts-metrics",
        "timeField": "period",
        "sql": "SELECT time_bucket('5 minutes', ts) AS period, floor(duration_ms / 50) * 50 AS bucket, count(*) AS requests FROM http_requests GROUP BY period, bucket ORDER BY period, bucket"
      },
      "options": {
        "bucket": "bucket",
        "count": "requests",
        "decimals": 0,
        "log": true,
        "thresholds": [
          {
            "value": 0,
            "color": "success"
          },
          {
            "value": 300,
            "color": "warning"
          },
          {
            "value": 1000,
            "color": "danger"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": "prom-latency",
      "title": "Request latency, last hour",
      "viz": "histogram",
      "query": {
        "sourceId": "prom-metrics",
        "promql": "sum by (le) (increase(http_request_duration_seconds_bucket[1h]))",
        "instant": true
      },
      "options": {
        "cumulative": true,
        "bucket": "le",
        "unit": "s"
      },
      "layout": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    }
  ]
}
