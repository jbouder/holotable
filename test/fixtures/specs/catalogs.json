          {
            "name": "value",
            "type": "double precision"
          }
        ]
      },
      {
        "name": "http_requests",
        "timeField": "ts",
        "columns": [
          {
            "name": "ts",
            "type": "timestamp with time zone"
          },
          {
            "name": "service",
            "type": "text"
